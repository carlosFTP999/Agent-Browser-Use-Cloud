# ---------------------------------------------------------------------------
# Agent-Browser-Use-Cloud — configuración de entorno
# Copiar a .env y rellenar. Nunca commitear .env (ver .gitignore).
# Principios: $0 asumido, sin Python en prod, reciclado 15 min, LLM configurable.
# ---------------------------------------------------------------------------

# API key de Browser-Use Cloud BaaS.
# Origen: https://cloud.browser-use.com (consola) -> X-Browser-Use-API-Key
# Se envía como header en POST/DELETE /api/vX/browsers.
BROWSER_USE_API_KEY=

# ID de perfil persistente (hasta 10 en Free). Se REUSAA al reciclar cada 15 min
# para retomar sin perder estado (cookies/storage/login). Puede ser cualquier
# string estable, p.ej. prof_agent01.
PROFILE_ID=

# --- LLM: cliente compatible con la API de OpenAI (proveedor-agnostico) ---
# PicoClaw usa openai-go; configura un endpoint OpenAI-compatible cualquiera.
# Requisito: free tier + multimodal (texto+imagen). Nunca modelo Pro/de pago.
# No enviar secretos ni PII en prompts.

# URL base de la API OpenAI-compatible. Vacío = OpenAI por defecto (https://api.openai.com/v1).
#   OpenAI   : https://api.openai.com/v1
#   Gemini   : https://generativelanguage.googleapis.com/v1beta/openai/
#   Groq     : https://api.groq.com/openai/v1
#   Together : https://api.together.xyz/v1
LLM_BASE_URL=

# API key del LLM elegido (OpenAI / Google AI Studio / console.groq.com / etc.).
LLM_API_KEY=

# Modelo del LLM (ej. gemini-3-flash). Libre + multimodal.
LLM_MODEL=

# Maximo de imagenes por request para multimodal (0 = sin imagen). Default 5.
LLM_MAX_IMAGES=5

# Geo-targeting del navegador remoto. null = proxyless (asume $0 egress).
# Solo fijar un código ISO (ej. US) si se requiere geo-targeting justificado.
PROXY_COUNTRY_CODE=null

# Socket Unix del daemon go-harnessless (puente CDP). No cambiar salvo motivo.
HARNESSLESS_SOCK=/tmp/harnessless.sock

# URL CDP remota (wss://). Normalmente la fija en runtime el agente tras
# POST /api/vX/browsers. Dejar vacía; el agente la inyecta al reciclar.
# HARNESSLESS_CDP_URL=
